        <hspi:project>
            <hspi:uniqueId>OPR-W386-TJ-26</hspi:uniqueId>
            <hspi:name>Lake Erie</hspi:name>
            <hspi:fieldUnit>NOAA Ship Thomas Jefferson (S222)</hspi:fieldUnit>
            <hspi:state>New York</hspi:state>
